PORT=4001
# Required in production: a random string of 32+ characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hotel_booking

# Gmail address to send OTP emails from, and a Gmail App Password for it
# (Google Account -> Security -> 2-Step Verification -> App passwords).
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Same Razorpay keys as web/server — used to issue refunds when an admin cancels a paid booking.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public addresses used for links inside emails, and the support address shown to guests.
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:4200
SUPPORT_EMAIL=support@stayfarer.in
