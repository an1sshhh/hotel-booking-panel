PORT=4001
# Required in production: a random string of 32+ characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hotel_booking
# Hosted database (Supabase / Neon): paste its connection string here instead of the DB_* values above.
# Use the Supabase *session pooler* string (port 5432) — not the IPv6-only direct host, and not the
# transaction pooler on 6543 (breaks the row locks used for bookings). Leave the password out of the
# URL and put it in DATABASE_PASSWORD so special characters don't need escaping.
# DATABASE_URL=postgresql://postgres.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_PASSWORD=
# true for hosted PostgreSQL (encrypted connections); leave false locally
DB_SSL=false
# Supabase signs with its own CA: Dashboard → Database settings → SSL → download certificate, save it here.
# DB_SSL_CA_FILE=certs/supabase-ca.crt
# Supabase free plan allows ~60 connections; two servers × 10 fits comfortably.
# DB_POOL_MAX=10

# Email — pick ONE transport:
# 1) Gmail relay script over HTTPS (use this when hosted: Render's free plan blocks SMTP ports).
#    Deploy scripts/gmail-relay.gs as a Google Apps Script web app (steps inside the file).
# GMAIL_SCRIPT_URL=https://script.google.com/macros/s/<deployment-id>/exec
# GMAIL_SCRIPT_SECRET=
# EMAIL_FROM=you@gmail.com
# 2) Gmail SMTP (local dev): the address plus a Gmail App Password
#    (Google Account -> Security -> 2-Step Verification -> App passwords).
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Image uploads. Set these when hosted (the server's disk is wiped on every deploy); unset = local uploads/ folder.
# Supabase -> Project Settings -> API Keys: the project URL and a *secret* key (sb_secret_..., server only).
# The public bucket is created on the first upload.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=images

# Same Razorpay keys as web/server — used to issue refunds when an admin cancels a paid booking.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public addresses used for links inside emails, and the support address shown to guests.
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:4200
SUPPORT_EMAIL=support@stayfarer.in

# Comma-separated frontend origins allowed to call this API when hosted. Unset = any origin (local dev).
# CORS_ORIGINS=https://stayfarer-admin.vercel.app
